{
  "title": "Order placed",
  "description": "v3: amount as a decimal string, so it can carry fractions of a cent; customer_id now always set",
  "type": "object",
  "properties": {
    "order_id":    { "type": "string", "format": "uuid" },
    "amount":      { "type": "string", "description": "decimal, e.g. \"12.50\"" },
    "currency":    { "enum": ["USD", "EUR"] },
    "created_at":  { "type": "string", "format": "date-time" },
    "customer_id": { "type": "string", "minLength": 1 }
  },
  "required": ["order_id", "amount", "currency", "created_at", "customer_id"],
  "additionalProperties": false
}
